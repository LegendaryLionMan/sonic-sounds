    },
    {
      "id": "07_cassette_sticker",
      "display_name": "Cassette Sticker",
      "depends_on": ["06_cover_art"],
      "approval_required": false,
      "mmx_action": "image.generate",
      "output_table": "assets"
    },
    {
      "id": "08_audio_mastering",
      "display_name": "Audio Mastering",
      "depends_on": ["07_cassette_sticker"],
